generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum DocumentStatus {
  uploading
  pending
  processed
  failed
}

enum NotificationType {
  EXPIRY_WARNING
  SYSTEM_INFO
}

enum LlmDecision {
  clear
  flagged
  uncertain
}

enum RiskLevel {
  low
  medium
  high
}

enum ComplianceDecision {
  clear
  flagged
}

enum ReviewStatus {
  not_required
  pending
  approved
  rejected
}

model User {
  id    String    @id @default(uuid())
  name  String
  email String    @unique
  password String

  documents Document[]
  notifications Notification[]
  projects Project[]
  reviews DocumentEvaluation[] @relation("EvaluationReviewer")
  crewMembers CrewMember[]
  reminders Reminder[]
}

model Document {
  id               String         @id @default(uuid())
  userId           String
  originalName     String
  storagePath      String
  mimeType         String
  uploadDate       DateTime       @default(now())
  status           DocumentStatus @default(pending)
  extractedData    Json?
  processingError  String?
  projectId        Int
  contentHash      String?
  byteSize         Int?
  crewMemberId     String?
  notifications    Notification[]
  chunks           DocumentChunk[]
  evaluations      DocumentEvaluation[]
  reminders        Reminder[]

  user             User           @relation(fields:[userId], references: [id])
  project          Project        @relation(fields:[projectId], references: [id])
  crewMember       CrewMember?    @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)

  @@index([userId, projectId, contentHash])
  @@index([crewMemberId])
}

/// One compliance evaluation of a document. Reprocessing inserts a new row so
/// earlier model/prompt versions remain auditable.
model DocumentEvaluation {
  id               String              @id @default(uuid())
  documentId       String
  createdAt        DateTime            @default(now())

  modelId          String
  promptVersion    String

  llmDecision      LlmDecision
  risk             RiskLevel
  confidence       Float
  issueType        String?
  explanation      String
  evidence         Json

  ruleHits         Json

  finalDecision    ComplianceDecision
  needsReview      Boolean
  routingReason    String

  reviewStatus     ReviewStatus
  reviewerId       String?
  reviewedAt       DateTime?
  reviewNote       String?
  overrideDecision ComplianceDecision?

  document         Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer         User?               @relation("EvaluationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([reviewStatus])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  documents   Document[]
  crewMembers CrewMember[]
}

/// A person (or company holder) inferred from extracted document fields.
model CrewMember {
  id             String   @id @default(uuid())
  userId         String
  projectId      Int
  name           String
  nameNormalized String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents      Document[]
  notifications  Notification[]
  reminders      Reminder[]

  @@unique([userId, projectId, nameNormalized])
  @@index([userId, projectId])
}

model Notification {
  id           Int              @id @default(autoincrement())
  type         NotificationType
  message      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime?
  read         Boolean          @default(false)
  emailSentAt  DateTime?

  documentId   String
  userId       String
  crewMemberId String?

  user         User             @relation(fields:[userId], references: [id])
  document     Document         @relation(fields:[documentId], references: [id], onDelete: Cascade)
  crewMember   CrewMember?      @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)

  @@index([userId, crewMemberId, type])
}

model Reminder {
  id           String   @id @default(uuid())
  userId       String
  crewMemberId String?
  documentId   String?
  toEmail      String
  subject      String
  body         String
  channel      String
  createdAt    DateTime @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// One retrievable window of a document's text.
///
/// `userId` and `projectId` are denormalised from Document on purpose: the
/// vector and keyword searches run as raw SQL (Prisma cannot express the `<=>`
/// operator or tsvector ranking), and keeping the access-control columns on
/// this table lets the filter sit inside the same indexed query rather than
/// being applied after the fact.
model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  projectId  Int
  chunkIndex Int
  pageNumber Int
  content    String

  /// Denormalised from Document.originalName so the generated tsvector can
  /// index it. Postgres generated columns cannot reference another table, and
  /// the document name ("White Card - J Smith.pdf") often carries the only
  /// occurrence of the document type near an expiry date.
  documentName String
  tokenCount Int
  createdAt  DateTime @default(now())

  /// vector(768) - gemini-embedding-001 truncated to 768 dimensions.
  /// Unsupported because Prisma has no native pgvector type.
  embedding Unsupported("vector(768)")?

  /// Generated tsvector over the document name plus the chunk body, maintained
  /// by Postgres. Defined in the migration; Prisma only needs to know it exists
  /// so `prisma db pull` does not try to drop it.
  searchVector Unsupported("tsvector")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId])
  @@index([documentId])
}
